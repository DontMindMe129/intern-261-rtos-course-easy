# Ex1: retain hardware evidence; ignore local runtimes, caches and self-checks.
/week2/ex1/measurements/*
!/week2/ex1/measurements/N16/
!/week2/ex1/measurements/S0/
!/week2/ex1/measurements/SF/
!/week2/ex1/measurements/FI/
